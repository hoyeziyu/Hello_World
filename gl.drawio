        </mxCell>
        <mxCell id="cYE6_IvR5H0RiS_5lmuA-10" parent="1" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;我们创建的帧缓冲区&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;不是默认帧缓冲区&lt;/font&gt;，因此渲染命令不会影响窗口的视觉输出（称为离屏渲染&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;off-screen rendering&lt;/font&gt;）&lt;/font&gt;" vertex="1">
