        <mxCell id="U2E2hztSpvb8zXg09PT2-24" parent="1" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=center;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;3.&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;text-align: center; font-size: 16px;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot;&gt;所有附件&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: Gudea, sans-serif; font-size: 16px; text-align: center;&quot;&gt;attachment&lt;/span&gt;&lt;span style=&quot;font-family: Gudea, sans-serif; font-size: 16px; text-align: center;&quot;&gt;也应该是完整的（预留内存）&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="410" x="4447.179999999999" y="-1866.86" as="geometry" />
        </mxCell>
        <mxCell id="U2E2hztSpvb8zXg09PT2-28" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;labelBackgroundColor=none;" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;附件是一块可以作为帧缓冲区的内存区域&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 16px;&quot;&gt;，可以把它想象成一个图像(纹理)。&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;当创建附件时，我们有两个选择：&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;textures&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;适用&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;需要从特定缓冲区&lt;/font&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;采样数据&lt;/font&gt;&lt;/span&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;或renderbuffer对象&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;（不能直接读取，只写，性能比texture更优， 适用&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot;&gt;不需要从缓冲区进行采样时&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 16px; font-family: Gudea, sans-serif; background-color: transparent;&quot;&gt;）。&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="550" x="5010" y="-1975" as="geometry" />
        </mxCell>
        <mxCell id="cYE6_IvR5H0RiS_5lmuA-11" edge="1" parent="1" source="U2E2hztSpvb8zXg09PT2-22" style="edgeStyle=entityRelationEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=none;segment=10;curved=1;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;" target="U2E2hztSpvb8zXg09PT2-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U2E2hztSpvb8zXg09PT2-22" parent="1" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=center;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;2.&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot;&gt;至少要有一种颜色color的&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: Gudea, sans-serif; background-color: transparent; font-size: 16px; text-align: center;&quot;&gt;附件&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-family: Gudea, sans-serif; font-size: 16px; background-color: transparent;&quot;&gt;attachment (&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;font color=&quot;#ff8000&quot; face=&quot;Gudea, sans-serif&quot;&gt;附件附加到帧缓冲区&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;)，&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;也可以&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;font color=&quot;#ff8000&quot; face=&quot;Gudea, sans-serif&quot;&gt;深度纹理和模板纹理附加到帧缓冲区对象&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
