        <mxCell id="v7ECg2o4vd-ZcSfef4AK-3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;labelBackgroundColor=none;" value="&lt;span style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;只照亮光源附近的区域，而不是整个场景&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px; font-family: Gudea, sans-serif; text-align: start; background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;eg: 灯泡，手电筒&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="271" x="3029" y="2560" as="geometry" />
        </mxCell>
        <mxCell id="Vk2pX9wyjKoTmjqXzQ-a-50" parent="1" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=center;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font color=&quot;#ff8000&quot; face=&quot;Gudea, sans-serif&quot;&gt;只向特定方向发射光线。因此，只有聚光灯照射范围内一定半径内的物体才会被照亮&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font color=&quot;#ff8000&quot; face=&quot;Gudea, sans-serif&quot;&gt;聚光灯由世界空间位置、方向和截止角cutoff angle（聚光灯的半径）表示；&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot; style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;需考虑&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0)); font-family: Gudea, sans-serif; font-size: 16px;&quot;&gt;光滑的聚光灯的效果(&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; text-align: center; font-size: 16px;&quot;&gt;&lt;font color=&quot;#ff8000&quot; face=&quot;Gudea, sans-serif&quot;&gt;需要插值考虑平滑/柔和的边缘&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0)); font-family: Gudea, sans-serif; font-size: 16px; background-color: transparent;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="630" x="3011.12" y="2760" as="geometry" />
        </mxCell>
