ar(--ge-dark-color, #121212)); font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 观看者(相机)的世界空间位置&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;和片段fragment位置&lt;/font&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;来计算&lt;/span&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); font-family: Gudea, sans-serif; font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;最后需要&lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;&lt;font color=&quot;#ff8000&quot; face=&quot;Gudea, sans-serif&quot;&gt;高光的亮度值&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
