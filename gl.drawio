          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gEPsc1wHJvY3szKM7q9a-29" parent="1" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=center;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font color=&quot;#ce6100&quot; face=&quot;Gudea, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;把镜面反射的颜色值 改为 纹理贴图，叫镜面反射贴图&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font face=&quot;Gudea, sans-serif&quot;&gt;&lt;font color=&quot;#dc7e2b&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;用于设置每个片段&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;color: rgb(255, 128, 0); font-family: Gudea, sans-serif; font-size: 16px; caret-color: rgba(0, 0, 0, 0); background-color: transparent;&quot;&gt;fragment&lt;/span&gt;&lt;span style=&quot;font-size: 16px; color: light-dark(rgb(220, 126, 43), rgb(186, 105, 34)); font-family: Gudea, sans-serif; background-color: transparent;&quot;&gt;的高光强度/颜色。它允许仅在物体的特定区域显示高光&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="630" x="3024.19" y="2160" as="geometry" />
