        <mxCell id="7ELFgi_1hK37CwDkCnU3-2" parent="7ELFgi_1hK37CwDkCnU3-5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0)); font-size: 18px;&quot;&gt;齐次坐标系是一种用 N+1 个数字表示 N 维坐标的方法；&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0)); font-size: 18px;&quot;&gt;&amp;nbsp;“齐次的”点 ，因为它们代表欧几里得空间（或笛卡尔空间）中的同一个点。换句话说，齐次坐标具有尺度不变性&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="92.98" width="480" as="geometry" />
        </mxCell>
