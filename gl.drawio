        <UserObject label="" id="2-AAIQNz_xz8K_XazVP7-2">
          <mxCell parent="2-AAIQNz_xz8K_XazVP7-17" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d0cee2;strokeColor=#56517e;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1">
