        <mxCell id="TfP0Sopcaeqt1ym7ZBFb-28" parent="TfP0Sopcaeqt1ym7ZBFb-40" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=center;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-family: Gudea, sans-serif; font-size: 16px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(221, 218, 214), rgb(255, 255, 255));&quot;&gt;multisampling&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
