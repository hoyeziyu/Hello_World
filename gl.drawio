        <mxCell id="dI0U-zX7RB7XNhA1Jiry-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;组件&lt;/font&gt;" vertex="1">
