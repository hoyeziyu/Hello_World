        <mxCell id="32m44d9N0e-9UPWyHcc5-194" value="&lt;font style=&quot;font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;每个Level保存为单独的 .umap 文件,&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;所有参与者被序列化为.umap的地图包&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="32m44d9N0e-9UPWyHcc5-196" vertex="1">
