        <mxCell id="32m44d9N0e-9UPWyHcc5-195" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;A World是一个对象，可以将Level“打开”到其中，包含一个或多个Level（相关联的Level，属于同一个World的Level）&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;A Level是一种Assert，包含Actor和Actor Component等其他内容&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=center;" parent="32m44d9N0e-9UPWyHcc5-196" vertex="1">
