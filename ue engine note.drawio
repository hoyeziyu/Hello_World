        </mxCell>
        <mxCell id="MruMh60Lzg2McTWY6-ha-38" value="&lt;span style=&quot;box-sizing: border-box; font-family: Inter, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; text-align: start;&quot; data-immersive-translate-walked=&quot;b958de76-de91-4721-9d93-d3ea6e5aa7ce&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Replicated&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;box-sizing: border-box; font-family: Inter, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; text-align: start;&quot; data-immersive-translate-walked=&quot;b958de76-de91-4721-9d93-d3ea6e5aa7ce&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Using Properties&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
