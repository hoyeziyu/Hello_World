          <mxGeometry height="30" width="180" x="4303.5" y="5846" as="geometry" />
        </mxCell>
        <mxCell id="6XSrzL24SEYXuZ5DD-VK-276" edge="1" parent="1" source="6XSrzL24SEYXuZ5DD-VK-249" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.001;entryY=0.574;entryDx=0;entryDy=0;entryPerimeter=0;" target="6XSrzL24SEYXuZ5DD-VK-275">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6XSrzL24SEYXuZ5DD-VK-277" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=left;" value="&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 128, 0));&quot;&gt;RAII 模式确保资源的生命周期与管理它们的对象的生命周期紧密相关。这意味着资源在对象的构造函数中初始化，并在析构函数中释放，从而简化了内存管理&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="206" x="4303.5" y="5876" as="geometry" />
        </mxCell>
        <mxCell id="6XSrzL24SEYXuZ5DD-VK-278" edge="1" parent="1" source="6XSrzL24SEYXuZ5DD-VK-279" style="edgeStyle=entityRelationEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=none;segment=10;curved=1;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;" target="6XSrzL24SEYXuZ5DD-VK-112">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6XSrzL24SEYXuZ5DD-VK-279" parent="1" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=center;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot; face=&quot;Open Sans&quot;&gt;出于性能优化的考虑，析构函数默认是静态绑定的&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Open Sans&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;如果一个类型有 virtual 函数，那么它也应该有一个 virtual 析构函数。&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Open Sans&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;可以实现一个 virtual 默认析构函数。&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 255, 0));&quot;&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left; --darkreader-inline-color: light-dark(#e8ab79, #7e4a1f);&quot; data-darkreader-inline-color=&quot;&quot; class=&quot;token&quot;&gt;virtual&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left; --darkreader-inline-color: light-dark(#e8ab79, #7e4a1f);&quot; data-darkreader-inline-color=&quot;&quot; class=&quot;token&quot;&gt;~&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left; --darkreader-inline-color: light-dark(#c190e0, #7f5599);&quot; data-darkreader-inline-color=&quot;&quot; class=&quot;token&quot;&gt;Character&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left; --darkreader-inline-co