 transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left; --darkreader-inline-color: light-dark(#e8ab79, #7e4a1f);&quot; data-darkreader-inline-color=&quot;&quot; class=&quot;token&quot;&gt;default&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); color: rgb(227, 234, 242); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left; --darkreader-inline-color: light-dark(#c9d8e6, #2a3743);&quot; data-darkreader-inline-color=&quot;&quot; class=&quot;token&quot;&gt;;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space-collapse: preserve; box-sizing: border-box; border: 0px solid rgb(55, 60, 62); margin: 0px; padding: 0px; outline-color: oklab(0.430592 -0.00601117 -0.00693688 / 0.5); color: rgb(201, 216, 230); font-family: Consolas, Monaco, &amp;quot;Andale Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, monospace; font-size: 14px; text-align: left;&quot;&gt; &lt;/span&gt;&lt;/div&gt;" vertex="1">
